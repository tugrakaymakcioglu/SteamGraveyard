# Required only for `steam-graveyard update` and scheduled catalog scans.
STEAM_API_KEY=

# Optional runtime configuration.
# STEAM_GRAVEYARD_DATA_DIR=./data
STEAM_GRAVEYARD_DELISTING_THRESHOLD=3
STEAM_GRAVEYARD_STALE_DAYS=30
STEAM_GRAVEYARD_PAGE_SIZE=200
STEAM_GRAVEYARD_MIN_SNAPSHOT_RATIO=0.8
STEAM_GRAVEYARD_REQUEST_TIMEOUT=20
STEAM_GRAVEYARD_LOG_LEVEL=INFO
